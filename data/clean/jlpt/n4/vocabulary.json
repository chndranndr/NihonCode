ません。","いくらちゅういしたらしずかになりましたか。","ちゅういしてもいくらしずかになりません。","ちゅういしたらいくらしずかになりました。"],"prompt":"いくら"},{"answer_index":0,"answer_text":"あした雨だったらしあいはちゅうしします。","id":"jlpt:n4:vocabulary:22:1wpmrf96","number":7,"options":["あした雨だったらしあいはちゅうしします。","あの人は会社をちゅうしして大学にいくらしい。","けんこうによくないのでたばこをすうのはちゅうしします。","バスがちゅうしして学校におくれた。"],"prompt":"ちゅうし"},{"answer_index":3,"answer_text":"近くに来るきかいがあったら、ぜひあそびに来てください。","id":"jlpt:n4:vocabulary:22:zzgfnl2k","number":8,"options":["ざんねんですが、その日はべつのきかいがあります。","わたしは日本のれきしにきかいがあります。","両親は外国へいったきかいがありません。","近くに来るきかいがあったら、ぜひあそびに来てください。"],"prompt":"きかい"},{"answer_index":0,"answer_text":"このまちはよるもあんぜんです。","id":"jlpt:n4:vocabulary:22:1fl993w1","number":9,"options":["このまちはよるもあんぜんです。","にちようびはいつもいえであんぜんにしています。","このきかいはあんぜんてきにつかってください。","わたしはげんきですから、あんぜんしてください。"],"prompt":"あんぜん"},{"answer_index":1,"answer_text":"先生にケーキをさしあげました。","id":"jlpt:n4:vocabulary:22:1v36yo5h","number":10,"options":["つまにピアノをさしあげました。","先生にケーキをさしあげました。","とりにむしをさしあげました。","花に水をさしあげました。"],"prompt":"さしあげる"}],"set_number":22,"title":"JLPT N4 – Vocabulary Exercise 22","type":"vocabulary","url":"https://japanesetest4you.com/japanese-language-proficiency-test-jlpt-n4-vocabulary-exercise-22/"},{"audio":[],"level":"N4","questions":[{"answer_index":3,"answer_text":"チケット","id":"jlpt:n4:vocabulary:23:scyt92sl","number":1,"options":["イベント","サービス","ステレオ","チケット"],"prompt":"えいがの _______ を２まいかいました。"},{"answer_index":0,"answer_text":"はんたいされました","id":"jlpt:n4:vocabulary:23:1e1mwo61","number":2,"options":["はんたいされました","しょうたいされました","しょうかいされました","きょういくされました"],"prompt":"わたしたちのけっこんは父に _______ 。"},{"answer_index":3,"answer_text":"じゅんび","id":"jlpt:n4:vocabulary:23:6vo1c11t","number":3,"options":["しんぱい","しょうたい","しゅっせき","じゅんび"],"prompt":"あしたのパーティーは、どんなのみものを _______ しましょうか。"},{"answer_index":2,"answer_text":"なおしたら","id":"jlpt:n4:vocabulary:23:3p334f3n","number":4,"options":["かえしたら","すてたら","なおしたら","見つけたら"],"prompt":"だいじなうでどけいがこわれてしまいました。_______ 、とてもお金がかかりました。"},{"answer_index":1,"answer_text":"おいわい","id":"jlpt:n4:vocabulary:23:1w07a14g","number":5,"options":["あいさつ","おいわい","おまつり","おみまい"],"prompt":"きのうは母のたんじょうびだったので、_______ にくつをあげました。"},{"answer_index":1,"answer_text":"さわらないで","id":"jlpt:n4:vocabulary:23:1x6zz81q","number":6,"options":["うつらないで","さわらないで","のこらないで","まわらないで"],"prompt":"このガラスのにんぎょうはこわれやすいので、 _______ ください。"},{"answer_index":2,"answer_text":"おもちゃ","id":"jlpt:n4:vocabulary:23:nepfama3","number":7,"options":["ぐあい","やくそく","おもちゃ","ぶどう"],"prompt":"子どもが _______ をこわしてしまった。"},{"answer_index":0,"answer_text":"ちゅうし","id":"jlpt:n4:vocabulary:23:c9tlrxpv","number":8,"options":["ちゅうし","しょうかい","ちゅうしゃ","しょうち"],"prompt":"きょうのおまつりはたいふうのため _______ します。"},{"answer_index":2,"answer_text":"はらって","id":"jlpt:n4:vocabulary:23:aretp4fd","number":9,"options":["出して","とどけて","はらって","出かけて"],"prompt":"でんきだいは毎月ぎんこうで _______ ください。"},{"answer_index":1,"answer_text":"いってまいります","id":"jlpt:n4:vocabulary:23:1v46uqdt","number":10,"options":["おはようございます","いってまいります","おかえりなさい","ただいま"],"prompt":"うちを出るとき、「 _______ 。」といいます。"}],"set_number":23,"title":"JLPT N4 – Vocabulary Exercise 23","type":"vocabulary","url":"https://japanesetest4you.com/japanese-language-proficiency-test-jlpt-n4-vocabulary-exercise-23/"},{"audio":[],"level":"N4","questions":[{"answer_index":3,"answer_text":"ねっしん","id":"jlpt:n4:vocabulary:24:1gcwpdxa","number":1,"options":["あんしん","ざんねん","しんぱい","ねっしん"],"prompt":"たなかさんは、毎日 _______ にけんきゅうをしている。"},{"answer_index":2,"answer_text":"せい","id":"jlpt:n4:vocabulary:24:b5o10l1j","number":2,"options":["いん","がわ","せい","だい"],"prompt":"わたしの車は日本 _______ です。"},{"answer_index":3,"answer_text":"メートル","id":"jlpt:n4:vocabulary:24:5ymg0amd","number":3,"options":["ページ","カーテン","テーブル","メートル"],"prompt":"５ _______ おきに木をうえました。"},{"answer_index":0,"answer_text":"ぎじゅつ","id":"jlpt:n4:vocabulary:24:18ghapk1","number":4,"options":["ぎじゅつ","せつめい","ぼうえき","ゆしゅつ"],"prompt":"これからはコンピューターの _______ をもつ人がひつようになるだろう。"},{"answer_index":2,"answer_text":"かまいません","id":"jlpt:n4:vocabulary:24:1ex0ntx1","number":5,"options":["おだいじに","こちらこそ","かまいません","しつれいします"],"prompt":"「いま、ファックスをおくってもいいですか。」「ええ、_______ 。」"}],"set_number":24,"title":"JLPT N4 – Vocabulary Exercise 24","type":"vocabulary","url":"https://japanesetest4you.com/japanese-language-proficiency-test-jlpt-n4-vocabulary-exercise-24/"},{"audio":[],"level":"N4","questions":[{"answer_index":3,"answer_text":"だんぼう","id":"jlpt:n4:vocabulary:25:117cfch1","number":1,"options":["ゆしゅつ","れいぼう","ゆにゅう","だんぼう"],"prompt":"さむくなったのでそろそろ _______ がほしいですね。"},{"answer_index":1,"answer_text":"なるべく","id":"jlpt:n4:vocabulary:25:8i4yua10","number":2,"options":["なるほど","なるべく","それほど","そんなに"],"prompt":"あしたはしけんですから、_______ はやく来てください。"},{"answer_index":2,"answer_text":"いっけん","id":"jlpt:n4:vocabulary:25:v6g08v1d","number":3,"options":["いちだい","いちど","いっけん","いっこ"],"prompt":"このまちには、ほんやは _______ しかありません。"},{"answer_index":0,"answer_text":"しゅうかん","id":"jlpt:n4:vocabulary:25:1kksmipp","number":4,"options":["しゅうかん","れんしゅう","せいかつ","きょうみ"],"prompt":"わたしは毎朝 さんぽするのが _______ です。"},{"answer_index":3,"answer_text":"パソコン","id":"jlpt:n4:vocabulary:25:hu5bq8fd","number":5,"options":["オーバー","ガソリン","ステーキ","パソコン"],"prompt":"あたらしい _______ を２だいかいました。"},{"answer_index":3,"answer_text":"日本についてしらべるのにてきとうな本はありませんか。","id":"jlpt:n4:vocabulary:25:11ccwr01","number":6,"options":["このきせつはとてもてきとうでよくねむれます。","せんそうは人びとのせいかつにてきとうではありません。","わかい人にてきとうするホテルをしょうかいしてください。","日本についてしらべるのにてきとうな本はありませんか。"],"prompt":"てきとう"},{"answer_index":1,"answer_text":"Ａ「おげんきですか。」Ｂ「ええ、おかげさまで。」","id":"jlpt:n4:vocabulary:25:15f1gfq1","number":7,"options":["Ａ「ごめんなさい。」Ｂ「いいえ、おかげさまで。」","Ａ「おげんきですか。」Ｂ「ええ、おかげさまで。」","Ａ「それは いけませんね。」Ｂ「ええ、おかげさまで。」","Ａ「ありがとうございました。」Ｂ「いいえ、おかげさまで。」"],"prompt":"おかげさまで"},{"answer_index":2,"answer_text":"「もっとまじめにやりなさい。」としかられました。","id":"jlpt:n4:vocabulary:25:xuwdv9xm","number":8,"options":["「もうだいじょうぶですか。」としかられました。","「よくがんばりましたね。」としかられました。","「もっとまじめにやりなさい。」としかられました。","「いっしょにしらべましょう。」としかられました。"],"prompt":"しかる"},{"answer_index":0,"answer_text":"パーティーのじゅんびができました。","id":"jlpt:n4:vocabulary:25:x7akq4to","number":9,"options":["パーティーのじゅんびができました。","車のこしょりのじゅんびがまだできません。","空気がかわいているので、火事のじゅんびをします。","きょうならったかんじのじゅんびをもういちどいえでします。"],"prompt":"じゅんび"},{"answer_index":3,"answer_text":"わたしはピアノがうまくありません。","id":"jlpt:n4:vocabulary:25:15cdstz1","number":10,"options":["わたしのおとうとはすうがくがうまくありません。","きょうははれて、けしきがうまいです。","わたしのパソコンはいつもうまいです。","わたしはピアノがうまくありません。"],"prompt":"うまい"}],"set_number":25,"title":"JLPT N4 – Vocabulary Exercise 25","type":"vocabulary","url":"https://japanesetest4you.com/japanese-language-proficiency-test-jlpt-n4-vocabulary-exercise-25/"},{"audio":[],"level":"N4","questions":[{"answer_index":0,"answer_text":"アルバイト","id":"jlpt:n4:vocabulary:26:mn1ybydj","number":1,"options":["アルバイト","サービス","チェック","テキスト"],"prompt":"わたしは _______ をしながら、大学でべんきょうしています。"},{"answer_index":1,"answer_text":"ひきだし","id":"jlpt:n4:vocabulary:26:14mct2m1","number":2,"options":["おしいれ","ひきだし","カーテン","ベル"],"prompt":"さいふはつくえの _______ の中にあります。"},{"answer_index":0,"answer_text":"ゆれて","id":"jlpt:n4:vocabulary:26:1obo8sz1","number":3,"options":["ゆれて","きえて","にげて","まわって"],"prompt":"じしんでいえが _______ います。"},{"answer_index":2,"answer_text":"かんけい","id":"jlpt:n4:vocabulary:26:1q8rus21","number":4,"options":["はいかん","けいけん","かんけい","そんけい"],"prompt":"ことばはぶんかとふかい _______ があると言われています。"},{"answer_index":1,"answer_text":"しっぱい","id":"jlpt:n4:vocabulary:26:12cg5a41","number":5,"options":["しつれい","しっぱい","しゅっせき","しょうたい"],"prompt":"今年しけんに _______ しても、また来年がんばります。"},{"answer_index":2,"answer_text":"それで","id":"jlpt:n4:vocabulary:26:wxmisulx","number":6,"options":["では","けれど","それで","たとえば"],"prompt":"ずっと日本にすむつもりです。 _______ 今、日本語をべんきょうしています。"},{"answer_index":0,"answer_text":"おくれて","id":"jlpt:n4:vocabulary:26:78tsffan","number":7,"options":["おくれて","おわって","いそいで","まにあって"],"prompt":"きのうはじこで でんしゃが _______ たいへんでした。"},{"answer_index":1,"answer_text":"おくじょう","id":"jlpt:n4:vocabulary:26:lbmbxxnt","number":8,"options":["かいがん","おくじょう","じゅうしょ","くうこう"],"prompt":"このビルの _______ からうみが見えます。"},{"answer_index":3,"answer_text":"ほんやく","id":"jlpt:n4:vocabulary:26:1qx9v2sq","number":9,"options":["あんない"