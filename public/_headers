# Cloudflare Pages response headers (copied to dist/ by Vite).
# Every file under /assets/ carries a content hash in its name, so a changed
# file always gets a new URL; browsers may keep these for a year without
# asking again. index.html is not listed: it keeps the default revalidation,
# so a new deploy reaches users on their next visit.
# scripts/check-bundle.mjs fails the build if an unhashed file lands in
# /assets or this rule goes missing.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
